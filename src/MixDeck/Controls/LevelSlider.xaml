<UserControl x:Class="MixDeck.Controls.LevelSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Height="24" MinWidth="60" Focusable="False">
    <UserControl.Resources>
        <Style x:Key="InvisibleRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThumbOnlySlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource InvisibleRepeat}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource InvisibleRepeat}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="{StaticResource SurfaceBg}" />
                                                    <Ellipse x:Name="Dot" Margin="2"
                                                             Fill="{Binding Accent, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Dot" Property="Margin" Value="1" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Dot" Property="Margin" Value="0" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Host">
        <!-- track · volume fill (translucent accent) · live signal (solid accent) · thumb -->
        <Border x:Name="Track" Height="6" CornerRadius="3" Background="{StaticResource TrackBg}" VerticalAlignment="Center" Margin="8,0" />
        <Border x:Name="Fill" Height="6" CornerRadius="3" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0" Width="0"
                Background="{Binding Accent, ElementName=Root}" Opacity="0.25" />
        <Border x:Name="Meter" Height="6" CornerRadius="3" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0" Width="0"
                Background="{Binding Accent, ElementName=Root}" />
        <Slider x:Name="Slider" Style="{StaticResource ThumbOnlySlider}" Minimum="0" Maximum="100"
                SmallChange="2" LargeChange="10" IsMoveToPointEnabled="True"
                Value="{Binding Value, ElementName=Root, Mode=TwoWay}" />
    </Grid>
</UserControl>
