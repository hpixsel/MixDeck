<UserControl x:Class="MixDeck.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MixDeck.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             Foreground="{StaticResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,22,0,4" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtleText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface2Bg}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>

    <!-- dimmed backdrop; click outside the panel closes -->
    <Grid Background="#B0000000" MouseDown="Backdrop_MouseDown">
        <Border Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14"
                Width="760" Margin="0,40" MouseDown="Panel_MouseDown">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="24,18,14,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="Close (Esc)">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                    </Button>
                    <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
                </DockPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,0,24,24">
                    <StackPanel>
                        <!-- General -->
                        <TextBlock Style="{StaticResource Section}" Text="General" />
                        <CheckBox Content="Start with Windows (in the tray)" IsChecked="{Binding StartWithWindows}" Margin="0,4" />
                        <CheckBox Content="Show an on-screen popup when a hotkey is used" IsChecked="{Binding ShowOsd}" Margin="0,4" />
                        <Button Content="Run the setup wizard" Command="{Binding OpenWizardCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />

                        <!-- Routing -->
                        <TextBlock x:Name="RoutingSection" Style="{StaticResource Section}" Text="Audio routing" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="Apps play to a silent collector device and MixDeck captures each app from it separately. Don't pick real headphones or speakers here." />
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Collector device" Width="160" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding CollectorDevices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding CollectorId}" />
                        </DockPanel>
                        <CheckBox IsChecked="{Binding ManageDefaultDevice}" Margin="0,4">
                            <TextBlock TextWrapping="Wrap" Text="Make it the Windows default output (the previous one comes back when MixDeck closes)" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding GuardDefaultDevice}" IsEnabled="{Binding ManageDefaultDevice}" Margin="0,4">
                            <TextBlock TextWrapping="Wrap" Text="Keep it that way: if a game, Wave Link or Windows changes the default output, take it back right away" />
                        </CheckBox>

                        <!-- Ducking -->
                        <TextBlock x:Name="DuckingSection" Style="{StaticResource Section}" Text="Auto-ducking" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="While someone talks on the chosen channel (e.g. Chat), the selected channels get quieter and smoothly come back afterwards." />
                        <CheckBox Content="Enable auto-ducking" IsChecked="{Binding DuckingEnabled}" Margin="0,4,0,8" FontWeight="SemiBold" />
                        <StackPanel IsEnabled="{Binding DuckingEnabled}">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="When this channel plays" Width="160" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding Channels}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding DuckTriggerId}" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="duck these channels" Width="160" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <ItemsControl ItemsSource="{Binding DuckTargets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:DuckTargetViewModel">
                                            <CheckBox Content="{Binding Channel.Name}" IsChecked="{Binding IsSelected}" Margin="0,0,16,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource SubtleText}"
                                           Text="{Binding DuckAmountDb, StringFormat={}-{0:0} dB}" />
                                <TextBlock Text="by" Width="160" VerticalAlignment="Center" />
                                <Slider Minimum="3" Maximum="30" Value="{Binding DuckAmountDb}" SmallChange="1" LargeChange="3" TickFrequency="1" IsSnapToTickEnabled="True" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource SubtleText}"
                                           Text="{Binding DuckThresholdDb, StringFormat={}{0:0} dB}" />
                                <TextBlock Text="sensitivity (threshold)" Width="160" VerticalAlignment="Center" />
                                <Slider Minimum="-60" Maximum="-15" Value="{Binding DuckThresholdDb}" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                        ToolTip="Lower = reacts to quieter sounds" />
                            </DockPanel>
                        </StackPanel>

                        <!-- Profiles -->
                        <TextBlock Style="{StaticResource Section}" Text="Profiles" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="A profile remembers the volumes and mutes of every channel and output. It can switch on by itself when you start a chosen app; when that app closes, the previous settings come back." />
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ProfileViewModel">
                                    <Border Style="{StaticResource Row}">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Content="Apply" Command="{Binding ApplyCommand}" Margin="4,0" />
                                                    <Button Content="Save current" Command="{Binding OverwriteCommand}" Margin="4,0"
                                                            ToolTip="Overwrite this profile with the current slider settings" />
                                                    <Button Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}" ToolTip="Delete profile">
                                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                                    </Button>
                                                </StackPanel>
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource BrandBrush}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                         Visibility="{Binding IsActive, Converter={x:Static vm:Converters.BoolToVisibility}}" ToolTip="Active profile" />
                                                <TextBox Style="{StaticResource InlineEdit}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Margin="0,6,0,0">
                                                <TextBlock Text="Switch on while running:" Foreground="{StaticResource SubtleText}" FontSize="12" VerticalAlignment="Center" Width="130" />
                                                <TextBox Text="{Binding TriggerApps, UpdateSourceTrigger=LostFocus}" FontSize="12"
                                                         ToolTip="Comma-separated .exe names, e.g. cs2.exe, valorant.exe" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="Save current settings as a profile" Command="{Binding SaveNewProfileCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name for the new profile, e.g. Gaming, Work, Movie" />
                        </DockPanel>

                        <!-- Hotkeys -->
                        <TextBlock Style="{StaticResource Section}" Text="Hotkeys" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="They work system-wide, in games too. Click a shortcut box and press a combination with Ctrl, Alt, Shift or Win (Backspace clears it)." />
                        <ItemsControl ItemsSource="{Binding Hotkeys}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:HotkeyViewModel">
                                    <Border Style="{StaticResource Row}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}" ToolTip="Delete hotkey">
                                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                                </Button>
                                                <TextBox Width="150" IsReadOnly="True" Text="{Binding Gesture, Mode=OneWay}" Tag="{Binding}"
                                                         PreviewKeyDown="Gesture_PreviewKeyDown" GotKeyboardFocus="Gesture_GotFocus" LostKeyboardFocus="Gesture_LostFocus"
                                                         ToolTip="Click and press a shortcut" Cursor="Hand" FontWeight="SemiBold" />
                                                <ComboBox Width="190" Margin="8,0,0,0" ItemsSource="{x:Static vm:HotkeyViewModel.Actions}"
                                                          DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Action}" />
                                                <ComboBox Width="150" Margin="8,0,0,0" ItemsSource="{Binding Targets}"
                                                          DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding TargetId}" />
                                                <ComboBox Margin="8,0,8,0" ItemsSource="{Binding MixChoices}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                          SelectedValue="{Binding MixId}" Visibility="{Binding NeedsMix, Converter={x:Static vm:Converters.BoolToVisibility}}" />
                                            </DockPanel>
                                            <TextBlock Foreground="{StaticResource WarnBrush}" FontSize="12" Margin="0,4,0,0"
                                                       Text="This shortcut is taken by another app or invalid. Pick another one."
                                                       Visibility="{Binding Failed, Converter={x:Static vm:Converters.BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Add hotkey" Command="{Binding AddHotkeyCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />

                        <!-- Phone remote / API -->
                        <TextBlock Style="{StaticResource Section}" Text="Phone remote and API" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="Control the sliders from your phone, Home Assistant, a Stream Deck or your own scripts. Access needs the secret token included in the address." />
                        <CheckBox Content="Enable the phone remote and local API" IsChecked="{Binding RemoteEnabled}" Margin="0,4" FontWeight="SemiBold" />
                        <CheckBox Content="Reachable from the home network (phone, Home Assistant), not only from this PC" IsChecked="{Binding RemoteAllowLan}"
                                  IsEnabled="{Binding RemoteEnabled}" Margin="0,4,0,8" />
                        <Border Background="{StaticResource Surface2Bg}" CornerRadius="10" Padding="14" Margin="0,4,0,0"
                                Visibility="{Binding RemoteUrl, Converter={x:Static vm:Converters.NotEmptyToVisibility}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Background="#161920" CornerRadius="8" Padding="6" Margin="0,0,16,0"
                                        Visibility="{Binding RemoteAllowLan, Converter={x:Static vm:Converters.BoolToVisibility}}">
                                    <Image Source="{Binding RemoteQr}" Width="150" Height="150" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Scan with your phone's camera" FontWeight="SemiBold"
                                               Visibility="{Binding RemoteAllowLan, Converter={x:Static vm:Converters.BoolToVisibility}}" />
                                    <TextBlock Text="API address for scripts on this PC" FontWeight="SemiBold"
                                               Visibility="{Binding RemoteAllowLan, Converter={x:Static vm:Converters.InverseBoolToVisibility}}" />
                                    <TextBlock Style="{StaticResource Help}" Margin="0,2,0,8" Text="{Binding RemoteStatus}" />
                                    <TextBox Text="{Binding RemoteUrl, Mode=OneWay}" IsReadOnly="True" FontSize="12" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Copy address" Command="{Binding CopyRemoteUrlCommand}" Margin="0,0,8,0" />
                                        <Button Content="New token" Command="{Binding NewRemoteTokenCommand}"
                                                ToolTip="Invalidates the old address: devices must reconnect" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Help}" Foreground="{StaticResource WarnBrush}" Margin="0,6,0,0" Text="{Binding RemoteStatus}">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{x:Static vm:Converters.ErrorVisibility}">
                                    <Binding Path="RemoteEnabled" />
                                    <Binding Path="RemoteUrl" />
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>

                        <!-- Updates -->
                        <TextBlock x:Name="UpdatesSection" Style="{StaticResource Section}" Text="Updates" />
                        <TextBlock Style="{StaticResource Help}">
                            <Run Text="Installed version:" /> <Run Text="{Binding AppVersion, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". New versions come from the GitHub repository's Releases." />
                        </TextBlock>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Check now" Command="{Binding CheckUpdatesCommand}" Margin="8,0,0,0" IsEnabled="{Binding UpdateBusy, Converter={x:Static vm:Converters.Not}}" />
                            <TextBox Text="{Binding UpdateSource, UpdateSourceTrigger=LostFocus}" ToolTip="e.g. https://github.com/your-login/MixDeck" />
                        </DockPanel>
                        <DockPanel Visibility="{Binding UpdateStatus, Converter={x:Static vm:Converters.NotEmptyToVisibility}}">
                            <Button DockPanel.Dock="Right" Content="Install and restart" Style="{StaticResource PrimaryButton}" Command="{Binding InstallUpdateCommand}"
                                    Visibility="{Binding UpdateAvailable, Converter={x:Static vm:Converters.BoolToVisibility}}" Margin="8,0,0,0" />
                            <TextBlock Style="{StaticResource Help}" Margin="0" VerticalAlignment="Center" Text="{Binding UpdateStatus}" />
                        </DockPanel>

                        <!-- Advanced -->
                        <TextBlock Style="{StaticResource Section}" Text="Advanced" />
                        <CheckBox IsChecked="{Binding LowLatency}" Margin="0,4,0,10">
                            <TextBlock TextWrapping="Wrap" Text="Low-latency mode (smaller buffers; may crackle on a busy PC). Takes effect after restarting MixDeck." />
                        </CheckBox>
                        <Button Content="Open event log" Command="{Binding OpenLogCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
