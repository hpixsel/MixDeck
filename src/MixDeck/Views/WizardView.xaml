<UserControl x:Class="MixDeck.Views.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MixDeck.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             Foreground="{StaticResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtleText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="Check" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface2Bg}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#D0000000">
        <Border Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16"
                Width="640" Height="480" VerticalAlignment="Center" Padding="36,32,36,24">
            <!-- fixed size with the footer pinned to the bottom, so the buttons never move between steps -->
            <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding WizardStep, Converter={x:Static vm:Converters.StepDot}, ConverterParameter=0}" />
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding WizardStep, Converter={x:Static vm:Converters.StepDot}, ConverterParameter=1}" />
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding WizardStep, Converter={x:Static vm:Converters.StepDot}, ConverterParameter=2}" />
                        <Ellipse Width="8" Height="8" Fill="{Binding WizardStep, Converter={x:Static vm:Converters.StepDot}, ConverterParameter=3}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Skip" Command="{Binding WizardFinishCommand}" Margin="0,0,8,0"
                                Visibility="{Binding WizardStep, Converter={x:Static vm:Converters.StepIs}, ConverterParameter=0}" />
                        <Button Content="Back" Command="{Binding WizardBackCommand}" Margin="0,0,8,0"
                                Visibility="{Binding WizardStep, Converter={x:Static vm:Converters.PositiveToVisibility}}" />
                        <Button Content="Next" Command="{Binding WizardNextCommand}" Style="{StaticResource PrimaryButton}"
                                Visibility="{Binding IsLastWizardStep, Converter={x:Static vm:Converters.InverseBoolToVisibility}}" />
                        <Button Content="Let's go" Command="{Binding WizardFinishCommand}" Style="{StaticResource PrimaryButton}"
                                Visibility="{Binding IsLastWizardStep, Converter={x:Static vm:Converters.BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>
                <StackPanel>
                <!-- Step 0: concept -->
                <StackPanel Visibility="{Binding WizardStep, Converter={x:Static vm:Converters.StepIs}, ConverterParameter=0}">
                    <Image x:Name="Logo" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,16" />
                    <TextBlock Style="{StaticResource Title}" Text="Welcome to MixDeck" />
                    <TextBlock Style="{StaticResource Body}"
                               Text="MixDeck lets you set separately how loud each app is in your headphones and on your speakers. It works in three steps:" />
                    <UniformGrid Columns="3" Margin="0,4,0,8">
                        <Border Style="{StaticResource Check}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="#C084FC" />
                                <TextBlock Text="Apps" FontWeight="SemiBold" Margin="0,8,0,2" />
                                <TextBlock Text="Spotify, your browser, Discord, games…" Foreground="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Check}" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="#3DDC97" />
                                <TextBlock Text="Channels" FontWeight="SemiBold" Margin="0,8,0,2" />
                                <TextBlock Text="You group apps, e.g. Music, Chat" Foreground="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Check}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="#A78BFA" />
                                <TextBlock Text="Outputs" FontWeight="SemiBold" Margin="0,8,0,2" />
                                <TextBlock Text="Each channel has its own volume on each output" Foreground="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <!-- Step 1: outputs -->
                <StackPanel Visibility="{Binding WizardStep, Converter={x:Static vm:Converters.StepIs}, ConverterParameter=1}">
                    <TextBlock Style="{StaticResource Title}" Text="Where do you want to hear sound?" />
                    <TextBlock Style="{StaticResource Body}" Text="Pick a device for each output. Later you can add more outputs with the + button and set fallback devices." />
                    <ItemsControl ItemsSource="{Binding Mixes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:MixViewModel">
                                <Border Style="{StaticResource Check}">
                                    <DockPanel>
                                        <Border Width="32" Height="32" CornerRadius="8" Background="{Binding AccentTint}" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{Binding Accent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Width="120" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <ComboBox ItemsSource="{Binding DataContext.OutputDevices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding OutputDeviceId}" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Step 2: collector -->
                <StackPanel Visibility="{Binding WizardStep, Converter={x:Static vm:Converters.StepIs}, ConverterParameter=2}">
                    <TextBlock Style="{StaticResource Title}" Text="Collector device" />
                    <TextBlock Style="{StaticResource Body}"
                               Text="All apps play to one silent virtual output, and MixDeck captures each of them from it separately. That's why no driver has to be installed." />
                    <Border Style="{StaticResource Check}" Visibility="{Binding CollectorFound, Converter={x:Static vm:Converters.BoolToVisibility}}">
                        <DockPanel>
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource OkBrush}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="Collector device found. You can change it below." VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Check}" Visibility="{Binding CollectorFound, Converter={x:Static vm:Converters.InverseBoolToVisibility}}">
                        <DockPanel>
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource WarnBrush}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Top" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="The default device wasn't found (Steam Streaming Speakers comes with Steam). Install the free VB-Cable (vb-audio.com/Cable) and pick “CABLE Input” below." />
                        </DockPanel>
                    </Border>
                    <ComboBox ItemsSource="{Binding CollectorDevices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding CollectorId}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Step 3: conflicts + autostart -->
                <StackPanel Visibility="{Binding WizardStep, Converter={x:Static vm:Converters.StepIs}, ConverterParameter=3}">
                    <TextBlock Style="{StaticResource Title}" Text="Finishing touches" />
                    <TextBlock Style="{StaticResource Body}" Text="Other mixers (Wave Link, Voicemeeter) change the Windows default device and fight MixDeck over audio." />
                    <Border Style="{StaticResource Check}" Visibility="{Binding WaveLinkRunning, Converter={x:Static vm:Converters.BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Close Wave Link" Command="{Binding CloseWaveLinkCommand}" />
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource WarnBrush}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="Elgato Wave Link is running." VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Check}" Visibility="{Binding WaveLinkAutostart, Converter={x:Static vm:Converters.BoolToVisibility}}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Disable autostart" Command="{Binding DisableWaveLinkAutostartCommand}" />
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource WarnBrush}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="Wave Link starts with Windows." VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Margin="28,6,0,0" FontSize="12" Foreground="{StaticResource SubtleText}">
                                <Run Text="If that doesn't work:" />
                                <Hyperlink Command="{Binding OpenStartupSettingsCommand}" Foreground="{StaticResource BrandBrush}">Settings → Apps → Startup</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <CheckBox Content="Start MixDeck with Windows (in the tray)" IsChecked="{Binding StartWithWindows}" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,16,0,0"
                               Text="Tip: drag apps between channels; hotkeys and profiles are in settings (⚙). Clicking the tray icon opens the mini mixer." />
                </StackPanel>


                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
