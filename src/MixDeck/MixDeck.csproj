<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WPF0001: ThemeMode (Fluent theme) is marked experimental -->
    <NoWarn>$(NoWarn);WPF0001;MVVMTK0045</NoWarn>
    <AssemblyName>MixDeck</AssemblyName>
    <RootNamespace>MixDeck</RootNamespace>
    <Version>0.3.0</Version>
    <ApplicationIcon>..\..\assets\MixDeck.ico</ApplicationIcon>
    <!-- Custom Main (Program.cs) so the Velopack installer hooks run before WPF starts -->
    <StartupObject>MixDeck.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is used only for the tray icon; keep its types out of the global namespace -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel for the local API / phone remote -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="Remote\remote.html" LogicalName="remote.html" />
    <!-- Logo: generated by build\make-icon.ps1 -->
    <Resource Include="..\..\assets\logo.png" Link="Assets\logo.png" />
    <Resource Include="..\..\assets\MixDeck.ico" Link="Assets\MixDeck.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="YellowDogMan.RRNoise.NET" Version="0.1.9" />
  </ItemGroup>

</Project>
